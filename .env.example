# CyberSentinal Environment Configuration Template
# Copy this file to .env.local in the root (for frontend) and .env in backend/ (for backend)

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
# Base URL for the FastAPI backend service
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
# Application environment ('development', 'test', 'production')
CYBERSENTINEL_ENV=development

# Server Host and Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010

# Maximum concurrent background security scans
MAX_CONCURRENT_SCANS=3

# ==========================================
# Local Development Scan Isolation (OPT-IN ONLY)
# ==========================================
# SECURITY NOTICE:
# By default, all private IP spaces, loopback (127.0.0.1), link-local, and cloud metadata
# (169.254.169.254) are strictly blocked by the SSRF Guard.
# To scan a dedicated local test target during development or demo, set:
# ALLOW_LOCAL_DEV_SCAN=true and specify the exact LOCAL_DEV_TARGET.
# In production (CYBERSENTINEL_ENV=production), this setting is strictly ignored.
ALLOW_LOCAL_DEV_SCAN=false
LOCAL_DEV_TARGET=http://localhost:4000
